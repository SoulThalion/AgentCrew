{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento sessionStart",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento prompt",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento shell-antes",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento shell-despues",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento tool-fail",
        "matcher": "Shell",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento switch",
        "matcher": "SwitchMode",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento espera",
        "matcher": "AskQuestion",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento aprobacion",
        "matcher": "Shell",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento busqueda",
        "matcher": "WebSearch",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento subagentes",
        "matcher": "Task",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento leyendo",
        "matcher": "Read|Grep|Glob|SemanticSearch",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento espera-fin",
        "matcher": "AskQuestion|SwitchMode|Shell|WebSearch",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento subagentes-fin",
        "matcher": "Task",
        "timeout": 10
      },
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento herramienta-fin",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento respuesta",
        "timeout": 10
      }
    ],
    "afterAgentThought": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento pensamiento",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento stop",
        "timeout": 25
      }
    ],
    "sessionEnd": [
      {
        "command": "node ./hooks/agentcrew-hook.mjs --evento sessionEnd",
        "timeout": 10
      }
    ]
  }
}
