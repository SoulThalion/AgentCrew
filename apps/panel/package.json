{
  "name": "@agentcrew/panel",
  "version": "0.1.0",
  "private": true,
  "description": "Panel desktop de agentes Cursor",
  "author": "AgentCrew",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/bundle-electron.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && node scripts/prepare-dist.mjs && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentcrew/core": "*",
    "@agentcrew/dock-linux": "*",
    "@agentcrew/dock-macos": "*",
    "@agentcrew/dock-windows": "*",
    "@agentcrew/tts": "*",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
